<!-- HERO (video — same footage as the homepage's original hero) -->
<section class="hero hero-compact">
  <video class="hero-video" id="menu-hero-video" autoplay muted playsinline>
    <source src="newhero.mp4#t=5" type="video/mp4">
  </video>
  <div class="hero-overlay"></div>
  <script>
    (function () {
      var v = document.getElementById('menu-hero-video');
      if (!v) return;
      var START = 5;  // skip the clip's slow opening

      function toStart() { try { v.currentTime = START; } catch (e) {} }

      // #t=5 on the source is a native hint, but it isn't honoured everywhere,
      // so seek explicitly once metadata (and therefore duration) is known.
      if (v.readyState >= 1) toStart();
      else v.addEventListener('loadedmetadata', toStart, { once: true });

      // The `loop` attribute always restarts at 0, which would replay the very
      // intro we're skipping. Loop manually instead so every pass starts at 5s.
      v.addEventListener('ended', function () {
        toStart();
        var p = v.play();
        if (p && p.catch) p.catch(function () {});
      });

      // The `autoplay` attribute is silently denied on iPhones in Low Power
      // Mode (and data-saver browsers), leaving the hero frozen with no
      // native retry. A user gesture grants playback permission on iOS, so
      // kick a paused hero on the first one.
      ['touchstart', 'pointerdown', 'click', 'scroll', 'keydown'].forEach(function (evt) {
        window.addEventListener(evt, function () {
          if (v.paused && !v.ended) {
            var p = v.play();
            if (p && p.catch) p.catch(function () {});
          }
        }, { once: true, passive: true });
      });
    })();
  </script>
</section>

